{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singing",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": { "directory": "./_site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [{ "binding": "DB", "database_name": "singing", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "cloudflare/migrations" }],
  "r2_buckets": [{ "binding": "SONGS", "bucket_name": "singing-private-songs" }],
  "services": [{ "binding": "IDENTITY", "service": "pinplay-api", "entrypoint": "ClassroomIdentity" }],
  "ratelimits": [{ "name": "AUTH_RL", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "MAX_FILE_BYTES": "67108864", "OWNER_STORAGE_BYTES": "1073741824" }
}
